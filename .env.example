# Vite dev server proxies /api to this host (see vite.config.ts)
VITE_API_PROXY_TARGET=http://10.66.101.184:3002

# Optional auth for protected OCDC endpoints:
# - Either set a Bearer token (with or without "Bearer " prefix)
# - Or set an API key header used as X-API-Key
# VITE_API_BEARER_TOKEN=
# VITE_API_KEY=

# Optional NAVBLUE callsign source (used before OCDC/PDF fallback)
# VITE_NAVBLUE_BASE_URL=https://vkg.noc.vmc.navblue.cloud/RestAPI/nocrestapi/v1
# VITE_NAVBLUE_USER=
# VITE_NAVBLUE_PASSWORD=

# Valgfrit til production build: fuld base-URL til API (kræver CORS fra dit domæne)
# VITE_API_ROOT=http://10.66.101.184:3002/api/v1
